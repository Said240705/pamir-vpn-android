{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mognu VPN",
  "mainBinaryName": "mognu",
  "version": "0.3.0",
  "identifier": "app.mognu.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mognu VPN",
        "width": 1180,
        "height": 760,
        "minWidth": 400,
        "minHeight": 620,
        "center": true,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#120E33"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mognu",
    "shortDescription": "Mognu VPN — быстрое и приватное подключение",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/xray"],
    "resources": { "binaries/wintun.dll": "wintun.dll" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
